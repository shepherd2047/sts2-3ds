; Spine mesh vertex shader: screen-pixel position, uv, byte colour.
.fvec projection[4]

.constf myconst(0.0, 1.0, 0.00392156862745, 0.5)
.alias ones myconst.yyyy
.alias inv255 myconst.zzzz

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2

.proc main
	mov r0.xy, inpos.xy
	mov r0.z, myconst.w
	mov r0.w, ones
	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0
	mov outtc0, intex
	mul outclr, inv255, inclr
	end
.end
