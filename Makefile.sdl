# Desktop preview build (macOS/Linux/Windows MSYS2 with SDL2).
# Auto-parallelize across all available cores if -j is not passed
MAKEFLAGS += -j$(shell sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)

CXX ?= clang++
OPT ?= -O2

BASE_CXXFLAGS := -std=c++20 $(OPT) -g -Wall -Wno-missing-field-initializers -Wno-unused-parameter -MMD -MP

SDL_CFLAGS := $(shell sdl2-config --cflags 2>/dev/null)
SDL_LDFLAGS := $(shell sdl2-config --libs 2>/dev/null)

ifeq ($(OS),Windows_NT)
# Windows (MSYS2 UCRT64): plain console main(), no SDL2main wrapper.
SDL_CFLAGS := $(filter-out -Dmain=SDL_main,$(SDL_CFLAGS))
SDL_LDFLAGS := $(filter-out -lSDL2main -mwindows,$(SDL_LDFLAGS))
endif

CORE_SRC := $(wildcard source/core/*.cpp)
EXTRA_PREVIEW_SRC := source/spine/spine.cpp source/gfx/gfx_common.cpp source/platform_sdl/gfx_sdl.cpp source/audio/audio.cpp source/platform_sdl/audio_sdl.cpp $(wildcard source/ui/*.cpp) $(wildcard source/ui/*/*.cpp) source/main.cpp
SIM_SRC := test/sim.cpp
TEST_SRC := test/enchant_test.cpp test/afflict_test.cpp test/quests_test.cpp test/badges_test.cpp test/character_test.cpp test/silent_test.cpp test/necrobinder_test.cpp test/regent_test.cpp test/colorless_test.cpp test/defect_test.cpp test/ascension_dump.cpp test/ascension_test.cpp test/progress_test.cpp test/settings_test.cpp test/profile_test.cpp test/history_test.cpp test/modifiers_test.cpp test/daily_test.cpp test/achievements_test.cpp test/tutorials_test.cpp test/save_errors_test.cpp test/safe_file_test.cpp test/model_dump.cpp test/instanced_test.cpp

OBJ_DIR := build/obj

CORE_OBJS := $(patsubst %.cpp,$(OBJ_DIR)/%.o,$(CORE_SRC))
PREVIEW_EXTRA_OBJS := $(patsubst %.cpp,$(OBJ_DIR)/%.o,$(EXTRA_PREVIEW_SRC))
SIM_EXTRA_OBJS := $(patsubst %.cpp,$(OBJ_DIR)/%.o,$(SIM_SRC))
TEST_EXTRA_OBJS := $(patsubst %.cpp,$(OBJ_DIR)/%.o,$(TEST_SRC))

ALL_OBJS := $(CORE_OBJS) $(PREVIEW_EXTRA_OBJS) $(SIM_EXTRA_OBJS) $(TEST_EXTRA_OBJS)
DEPS := $(ALL_OBJS:.o=.d)

all: build/sts2-preview build/sim

# Core objects (shared between preview and sim, compiled ONCE)
$(OBJ_DIR)/source/core/%.o: source/core/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(BASE_CXXFLAGS) -c $< -o $@

# Preview-specific objects (include SDL headers)
$(OBJ_DIR)/source/%.o: source/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(BASE_CXXFLAGS) $(SDL_CFLAGS) -c $< -o $@

# Sim-specific objects
$(OBJ_DIR)/test/%.o: test/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(BASE_CXXFLAGS) -c $< -o $@

build/sts2-preview: $(CORE_OBJS) $(PREVIEW_EXTRA_OBJS)
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@ $(SDL_LDFLAGS)

build/sim: $(CORE_OBJS) $(SIM_EXTRA_OBJS)
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

# Engine unit checks (enchantments, characters): not part of `all`.
build/enchant_test: $(CORE_OBJS) $(OBJ_DIR)/test/enchant_test.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

build/afflict_test: $(CORE_OBJS) $(OBJ_DIR)/test/afflict_test.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

build/quests_test: $(CORE_OBJS) $(OBJ_DIR)/test/quests_test.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

# E6: instanced powers and the ITemporaryPower marker.
build/instanced_test: $(CORE_OBJS) $(OBJ_DIR)/test/instanced_test.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

build/character_test: $(CORE_OBJS) $(OBJ_DIR)/test/character_test.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

build/silent_test: $(CORE_OBJS) $(OBJ_DIR)/test/silent_test.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

build/necrobinder_test: $(CORE_OBJS) $(OBJ_DIR)/test/necrobinder_test.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

build/regent_test: $(CORE_OBJS) $(OBJ_DIR)/test/regent_test.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

build/colorless_test: $(CORE_OBJS) $(OBJ_DIR)/test/colorless_test.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

build/defect_test: $(CORE_OBJS) $(OBJ_DIR)/test/defect_test.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

build/ascension_test: $(CORE_OBJS) $(OBJ_DIR)/test/ascension_test.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

build/progress_test: $(CORE_OBJS) $(OBJ_DIR)/test/progress_test.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

build/settings_test: $(CORE_OBJS) $(OBJ_DIR)/test/settings_test.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

build/profile_test: $(CORE_OBJS) $(OBJ_DIR)/test/profile_test.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

build/history_test: $(CORE_OBJS) $(OBJ_DIR)/test/history_test.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

build/badges_test: $(CORE_OBJS) $(OBJ_DIR)/test/badges_test.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

build/daily_test: $(CORE_OBJS) $(OBJ_DIR)/test/daily_test.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

build/achievements_test: $(CORE_OBJS) $(OBJ_DIR)/test/achievements_test.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

# M13: the tutorials queue / seen flags (source/ui/tutorials.cpp is gfx-free).
build/tutorials_test: $(CORE_OBJS) $(OBJ_DIR)/test/tutorials_test.o $(OBJ_DIR)/source/ui/tutorials.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

# S22: corrupt saves load as "error + safe default".
build/save_errors_test: $(CORE_OBJS) $(OBJ_DIR)/test/save_errors_test.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

# Y5: atomic save writes and recovery after an interrupted write.
build/safe_file_test: $(CORE_OBJS) $(OBJ_DIR)/test/safe_file_test.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

build/modifiers_test:$(CORE_OBJS) $(OBJ_DIR)/test/modifiers_test.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

# Monster values per ascension level; compare with the C# through tools/ascension_check.py.
build/ascension_dump: $(CORE_OBJS) $(OBJ_DIR)/test/ascension_dump.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

# Card / relic / potion numbers; compare with the C# through tools/balance_check.py (H5).
build/model_dump: $(CORE_OBJS) $(OBJ_DIR)/test/model_dump.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

sim: build/sim
	./build/sim 200

check: build/enchant_test build/afflict_test build/quests_test build/character_test build/silent_test build/necrobinder_test build/regent_test build/colorless_test build/defect_test build/ascension_test build/ascension_dump build/progress_test build/settings_test build/profile_test build/history_test build/badges_test build/modifiers_test build/daily_test build/achievements_test build/tutorials_test build/save_errors_test build/safe_file_test build/model_dump build/instanced_test
	./build/enchant_test
	./build/afflict_test
	./build/quests_test
	./build/instanced_test
	./build/character_test
	./build/silent_test
	./build/necrobinder_test
	./build/regent_test
	./build/colorless_test
	./build/defect_test
	./build/ascension_test
	./build/progress_test
	./build/settings_test
	./build/profile_test
	./build/history_test
	./build/badges_test
	./build/modifiers_test
	./build/daily_test
	./build/achievements_test
	./build/tutorials_test
	./build/save_errors_test
	./build/safe_file_test
	for l in 0 8 9 10; do ./build/ascension_dump $$l > build/asc_dump_$$l.txt; done
	@PY=$$(command -v python3 || command -v python); if [ -n "$$PY" ] && [ -d ../sts2-decompiled ]; then $$PY tools/ascension_check.py; else echo "ascension_check skipped (needs python3 and ../sts2-decompiled)"; fi
	./build/model_dump > build/model_dump.txt
	@PY=$$(command -v python3 || command -v python); if [ -n "$$PY" ] && [ -d ../sts2-decompiled ]; then $$PY tools/balance_check.py; else echo "balance_check skipped (needs python3 and ../sts2-decompiled)"; fi

clean:
	rm -rf build

.PHONY: all sim check clean

-include $(DEPS)

# E9: card-text formatter check (links the preview objects except main).
build/cardtext_test: $(CORE_OBJS) $(filter-out $(OBJ_DIR)/source/main.o,$(PREVIEW_EXTRA_OBJS)) $(OBJ_DIR)/test/cardtext_test.o
	@mkdir -p build
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@ $(SDL_LDFLAGS)

run_cardtext_test: build/cardtext_test
	./build/cardtext_test

check: run_cardtext_test
.PHONY: run_cardtext_test
