# Desktop preview build (macOS/Linux/Windows MSYS2 with SDL2).
# Parallelism comes from the caller: `make -f Makefile.sdl -j4 ...` (on the Mac use the build scheduler,
# /Users/m/dev/sts2-build-lock.sh, which picks -j from a shared token pool). Never force -j here: on an
# 8 GB machine several builds x ncpu compilers swap the system to a crawl.
#
# DEV=1: fast iteration build for sims and tests (-O1, no debug info) in $(B)/dev/ with its own objects,
# so it never mixes with the release objects. Default (release): -O2 -g in $(B)/, as the docs assume.
# Run `make check` without DEV before merging.

CXX ?= clang++
DEV ?= 0
ifeq ($(DEV),1)
OPT ?= -O1
DBG ?=
B := build/dev
else
OPT ?= -O2
DBG ?= -g
B := build
endif

BASE_CXXFLAGS := -std=c++20 $(OPT) $(DBG) -Wall -Wno-missing-field-initializers -Wno-unused-parameter -MMD -MP

SDL_CFLAGS := $(shell sdl2-config --cflags 2>/dev/null)
SDL_LDFLAGS := $(shell sdl2-config --libs 2>/dev/null)

ifeq ($(OS),Windows_NT)
# Windows (MSYS2 UCRT64): plain console main(), no SDL2main wrapper.
SDL_CFLAGS := $(filter-out -Dmain=SDL_main,$(SDL_CFLAGS))
SDL_LDFLAGS := $(filter-out -lSDL2main -mwindows,$(SDL_LDFLAGS))
endif

CORE_SRC := $(wildcard source/core/*.cpp)
EXTRA_PREVIEW_SRC := source/spine/spine.cpp source/gfx/gfx_common.cpp source/platform_sdl/gfx_sdl.cpp source/audio/audio.cpp source/platform_sdl/audio_sdl.cpp $(wildcard source/ui/*.cpp) $(wildcard source/ui/*/*.cpp) source/main.cpp
SIM_SRC := test/sim.cpp
TEST_SRC := test/enchant_test.cpp test/afflict_test.cpp test/rewards_test.cpp test/hooks_test.cpp test/quests_test.cpp test/badges_test.cpp test/character_test.cpp test/silent_test.cpp test/necrobinder_test.cpp test/regent_test.cpp test/colorless_test.cpp test/defect_test.cpp test/ascension_dump.cpp test/ascension_test.cpp test/progress_test.cpp test/settings_test.cpp test/profile_test.cpp test/history_test.cpp test/modifiers_test.cpp test/daily_test.cpp test/achievements_test.cpp test/tutorials_test.cpp test/save_errors_test.cpp test/safe_file_test.cpp test/model_dump.cpp test/instanced_test.cpp test/combat_history_test.cpp test/pets_test.cpp test/debug_events_test.cpp

OBJ_DIR := $(B)/obj

CORE_OBJS := $(patsubst %.cpp,$(OBJ_DIR)/%.o,$(CORE_SRC))
PREVIEW_EXTRA_OBJS := $(patsubst %.cpp,$(OBJ_DIR)/%.o,$(EXTRA_PREVIEW_SRC))
SIM_EXTRA_OBJS := $(patsubst %.cpp,$(OBJ_DIR)/%.o,$(SIM_SRC))
TEST_EXTRA_OBJS := $(patsubst %.cpp,$(OBJ_DIR)/%.o,$(TEST_SRC))

ALL_OBJS := $(CORE_OBJS) $(PREVIEW_EXTRA_OBJS) $(SIM_EXTRA_OBJS) $(TEST_EXTRA_OBJS)
DEPS := $(ALL_OBJS:.o=.d) $(foreach d,asan ubsan,$(patsubst %.cpp,build/$(d)/%.d,$(CORE_SRC) $(SIM_SRC)))

all: $(B)/sts2-preview $(B)/sim

# Core objects (shared between preview and sim, compiled ONCE)
$(OBJ_DIR)/source/core/%.o: source/core/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(BASE_CXXFLAGS) -c $< -o $@

# Preview-specific objects (include SDL headers)
$(OBJ_DIR)/source/%.o: source/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(BASE_CXXFLAGS) $(SDL_CFLAGS) -c $< -o $@

# Sim-specific objects
$(OBJ_DIR)/test/%.o: test/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(BASE_CXXFLAGS) -c $< -o $@

$(B)/sts2-preview: $(CORE_OBJS) $(PREVIEW_EXTRA_OBJS)
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@ $(SDL_LDFLAGS)

$(B)/sim: $(CORE_OBJS) $(SIM_EXTRA_OBJS)
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

# Engine unit checks (enchantments, characters): not part of `all`.
$(B)/enchant_test: $(CORE_OBJS) $(OBJ_DIR)/test/enchant_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

$(B)/afflict_test: $(CORE_OBJS) $(OBJ_DIR)/test/afflict_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

$(B)/rewards_test: $(CORE_OBJS) $(OBJ_DIR)/test/rewards_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

$(B)/hooks_test: $(CORE_OBJS) $(OBJ_DIR)/test/hooks_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

$(B)/quests_test: $(CORE_OBJS) $(OBJ_DIR)/test/quests_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

# Pets (PlayerCmd.AddPet, Byrdpip, PaelsLegion).
$(B)/pets_test: $(CORE_OBJS) $(OBJ_DIR)/test/pets_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

# E6: instanced powers and the ITemporaryPower marker.
$(B)/instanced_test: $(CORE_OBJS) $(OBJ_DIR)/test/instanced_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

# Debug switches / runtime commands (core/debug_cmds.h) and the animation VisualEvents.
$(B)/debug_events_test: $(CORE_OBJS) $(OBJ_DIR)/test/debug_events_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

$(B)/combat_history_test: $(CORE_OBJS) $(OBJ_DIR)/test/combat_history_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

$(B)/character_test: $(CORE_OBJS) $(OBJ_DIR)/test/character_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

$(B)/silent_test: $(CORE_OBJS) $(OBJ_DIR)/test/silent_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

$(B)/necrobinder_test: $(CORE_OBJS) $(OBJ_DIR)/test/necrobinder_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

$(B)/regent_test: $(CORE_OBJS) $(OBJ_DIR)/test/regent_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

$(B)/colorless_test: $(CORE_OBJS) $(OBJ_DIR)/test/colorless_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

$(B)/defect_test: $(CORE_OBJS) $(OBJ_DIR)/test/defect_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

$(B)/ascension_test: $(CORE_OBJS) $(OBJ_DIR)/test/ascension_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

$(B)/progress_test: $(CORE_OBJS) $(OBJ_DIR)/test/progress_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

$(B)/settings_test: $(CORE_OBJS) $(OBJ_DIR)/test/settings_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

$(B)/profile_test: $(CORE_OBJS) $(OBJ_DIR)/test/profile_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

$(B)/history_test: $(CORE_OBJS) $(OBJ_DIR)/test/history_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

$(B)/badges_test: $(CORE_OBJS) $(OBJ_DIR)/test/badges_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

$(B)/daily_test: $(CORE_OBJS) $(OBJ_DIR)/test/daily_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

$(B)/achievements_test: $(CORE_OBJS) $(OBJ_DIR)/test/achievements_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

# M13: the tutorials queue / seen flags (source/ui/tutorials.cpp is gfx-free).
$(B)/tutorials_test: $(CORE_OBJS) $(OBJ_DIR)/test/tutorials_test.o $(OBJ_DIR)/source/ui/tutorials.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

# S22: corrupt saves load as "error + safe default".
$(B)/save_errors_test: $(CORE_OBJS) $(OBJ_DIR)/test/save_errors_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

# Y5: atomic save writes and recovery after an interrupted write.
$(B)/safe_file_test: $(CORE_OBJS) $(OBJ_DIR)/test/safe_file_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

$(B)/modifiers_test:$(CORE_OBJS) $(OBJ_DIR)/test/modifiers_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

# Monster values per ascension level; compare with the C# through tools/ascension_check.py.
$(B)/ascension_dump: $(CORE_OBJS) $(OBJ_DIR)/test/ascension_dump.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

# Card / relic / potion numbers; compare with the C# through tools/balance_check.py (H5).
$(B)/model_dump: $(CORE_OBJS) $(OBJ_DIR)/test/model_dump.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@

sim: $(B)/sim
	./$(B)/sim 200

# H2: sanitizer builds of the headless sim (host only; tools/soak.sh runs them), own object dirs.
# sim-ubsan is UBSan alone: ASan's runtime hangs at start-up on macOS 27 (both Apple clang 17 and
# LLVM 21), so there the soak pairs it with libmalloc's scribble/guard checks and `leaks`.
SAN_BASE := -fno-omit-frame-pointer -fno-sanitize-recover=undefined
ASAN_OBJS := $(patsubst %.cpp,build/asan/%.o,$(CORE_SRC) $(SIM_SRC))
UBSAN_OBJS := $(patsubst %.cpp,build/ubsan/%.o,$(CORE_SRC) $(SIM_SRC))
build/asan/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(BASE_CXXFLAGS) -O1 -fsanitize=address,undefined $(SAN_BASE) -c $< -o $@
build/ubsan/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(BASE_CXXFLAGS) -O1 -fsanitize=undefined $(SAN_BASE) -c $< -o $@
build/sim-asan: $(ASAN_OBJS)
	$(CXX) $(BASE_CXXFLAGS) -fsanitize=address,undefined $(SAN_BASE) $^ -o $@
build/sim-ubsan: $(UBSAN_OBJS)
	$(CXX) $(BASE_CXXFLAGS) -fsanitize=undefined $(SAN_BASE) $^ -o $@
sim-asan: build/sim-asan
sim-ubsan: build/sim-ubsan

check: $(B)/enchant_test $(B)/afflict_test $(B)/rewards_test $(B)/hooks_test $(B)/quests_test $(B)/character_test $(B)/silent_test $(B)/necrobinder_test $(B)/regent_test $(B)/colorless_test $(B)/defect_test $(B)/ascension_test $(B)/ascension_dump $(B)/progress_test $(B)/settings_test $(B)/profile_test $(B)/history_test $(B)/badges_test $(B)/modifiers_test $(B)/daily_test $(B)/achievements_test $(B)/tutorials_test $(B)/save_errors_test $(B)/safe_file_test $(B)/model_dump $(B)/instanced_test $(B)/combat_history_test $(B)/pets_test $(B)/debug_events_test
	./$(B)/enchant_test
	./$(B)/afflict_test
	./$(B)/rewards_test
	./$(B)/hooks_test
	./$(B)/quests_test
	./$(B)/pets_test
	./$(B)/debug_events_test
	./$(B)/instanced_test
	./$(B)/combat_history_test
	./$(B)/character_test
	./$(B)/silent_test
	./$(B)/necrobinder_test
	./$(B)/regent_test
	./$(B)/colorless_test
	./$(B)/defect_test
	./$(B)/ascension_test
	./$(B)/progress_test
	./$(B)/settings_test
	./$(B)/profile_test
	./$(B)/history_test
	./$(B)/badges_test
	./$(B)/modifiers_test
	./$(B)/daily_test
	./$(B)/achievements_test
	./$(B)/tutorials_test
	./$(B)/save_errors_test
	./$(B)/safe_file_test
	for l in 0 8 9 10; do ./$(B)/ascension_dump $$l > build/asc_dump_$$l.txt; done
	@PY=$$(command -v python3 || command -v python); if [ -n "$$PY" ] && [ -d ../sts2-decompiled ]; then $$PY tools/ascension_check.py; else echo "ascension_check skipped (needs python3 and ../sts2-decompiled)"; fi
	./$(B)/model_dump > build/model_dump.txt
	@PY=$$(command -v python3 || command -v python); if [ -n "$$PY" ] && [ -d ../sts2-decompiled ]; then $$PY tools/balance_check.py; else echo "balance_check skipped (needs python3 and ../sts2-decompiled)"; fi
	@PY=$$(command -v python3 || command -v python); if [ -n "$$PY" ] && $$PY -c 'import numpy, PIL' 2>/dev/null; then $$PY test/compress_romfs_test.py; else echo "compress_romfs_test skipped (needs python3 with numpy + Pillow)"; fi

clean:
	rm -rf build

.PHONY: all sim sim-asan sim-ubsan check clean

-include $(DEPS)

# E9: card-text formatter check (links the preview objects except main).
$(B)/cardtext_test: $(CORE_OBJS) $(filter-out $(OBJ_DIR)/source/main.o,$(PREVIEW_EXTRA_OBJS)) $(OBJ_DIR)/test/cardtext_test.o
	@mkdir -p $(B)
	$(CXX) $(BASE_CXXFLAGS) $^ -o $@ $(SDL_LDFLAGS)

run_cardtext_test: $(B)/cardtext_test
	./$(B)/cardtext_test

check: run_cardtext_test
.PHONY: run_cardtext_test

# build_assets Spine atlas scaling / repacking (no game files needed).
run_tools_test:
	@PY=$$(command -v python3 || command -v python); if [ -n "$$PY" ] && $$PY -c "import PIL, numpy" 2>/dev/null; then $$PY tools/test_build_assets.py; else echo "tools test skipped (needs python3 with Pillow and numpy)"; fi

check: run_tools_test
.PHONY: run_tools_test
